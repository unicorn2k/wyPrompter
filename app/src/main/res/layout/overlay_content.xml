<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/overlay_page_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="4dp"
        android:background="@drawable/bg_indicator"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:text="1/1" />

    <!--
        A ScrollView measures its child with an unbounded height, so the text
        can grow taller than the visible viewport. AutoScrollEngine then
        animates overlay_text.translationY by maxScrollOffset to scroll it.
    -->
    <ScrollView
        android:id="@+id/overlay_viewport"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="8dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <TextView
            android:id="@+id/overlay_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="left"
            android:lineSpacingExtra="4dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="28sp" />
    </ScrollView>
</FrameLayout>